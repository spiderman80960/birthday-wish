# Environment Variables for Birthday Letter & Deployment
PORT=3000

# Resend Email Service (for letter unlock notifications)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_123456789

# Email address to receive the notification when Ramya unlocks the letter
NOTIFICATION_EMAIL=raghavaram219@gmail.com

# (Optional) Override secret code to unlock the sealed letter
# If unset, defaults to the built-in cryptographic hash
# SECRET_CODE=your_secret_word

# (Optional) Verified sender email in Resend. Default is onboarding@resend.dev
# RESEND_FROM_EMAIL="Birthday Portal <onboarding@resend.dev>"

# (Optional) Public website URL for the email notification link
# WEBSITE_URL=https://your-website-domain.com
